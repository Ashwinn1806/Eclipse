# Eclipse Environment Configuration

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://postgres:password@localhost:5432/eclipse?schema=public
# Or Supabase / Neon / Render PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eclipse?schema=public"

# Google Gemini AI API Key for Macro Check-in Engine
GEMINI_API_KEY=""

# Optional App Settings
NEXT_PUBLIC_APP_NAME="Eclipse"
