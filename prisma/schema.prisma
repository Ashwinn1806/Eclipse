// Prisma schema for Eclipse Gym & Nutrition Tracker

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth User Model
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?       @map("email_verified")
  image         String?
  heightCm      Float?          @map("height_cm") // User's height in centimetres
  accounts      Account[]
  sessions      Session[]

  // Eclipse Relations
  goals         UserGoal[]
  nutrition     NutritionEntry[]
  dailyLogs     DailyLog[]
  weeklySnapshots WeeklySnapshot[]
  workouts      WorkoutSession[]

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

// NextAuth Account Model
model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// NextAuth Session Model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

// NextAuth VerificationToken Model
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User Goals table: Active macro targets and weight goals
model UserGoal {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  goalType             String    @map("goal_type") // "Bulk" | "Cut" | "Maintain"
  startWeight          Float     @map("start_weight")
  targetWeight         Float     @map("target_weight")
  targetDate           DateTime  @map("target_date")
  targetDailyCals      Int       @map("target_daily_cals")
  targetDailyProtein   Int       @map("target_daily_protein")
  targetDailyWaterMl   Int       @default(2500) @map("target_daily_water_ml") // Daily water target in ml
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_goals")
}

// Nutrition Entries table: Individual food, snack, or water items logged
model NutritionEntry {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  date        String   @map("date") // Format: "YYYY-MM-DD"
  itemName    String   @map("item_name")
  category    String   @map("category") // "Meal" | "Snack" | "Water"
  calories    Int      @map("calories")
  proteinG    Float    @map("protein_g")
  waterMl     Int      @default(0) @map("water_ml") // Water volume in ml (for Water category items)
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("nutrition_entries")
}

// Daily Logs table: Aggregates and morning weigh-in
model DailyLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  date           String   @map("date") // Format: "YYYY-MM-DD"
  morningWeight  Float?   @map("morning_weight") // Body weight in kg for that day
  totalCalories  Int      @default(0) @map("total_calories")
  totalProtein   Float    @default(0) @map("total_protein")
  totalWaterMl   Int      @default(0) @map("total_water_ml") // Total water consumed in ml for the day
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_logs")
}

// Weekly Snapshots table: AI Macro Check-In decision audit trail
model WeeklySnapshot {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  weekStartDate  DateTime @map("week_start_date")
  avgWeight      Float    @map("avg_weight")
  weightDelta    Float    @map("weight_delta")
  aiDecision     String   @map("ai_decision") @db.Text
  calsAdjustedBy Int      @map("cals_adjusted_by")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("weekly_snapshots")
}

// Workout Sessions table: A recorded training session
model WorkoutSession {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  date         DateTime     @default(now()) @map("date")
  splitDayName String       @map("split_day_name") // e.g. "Push Day A", "Pull Day", "Legs"
  totalTonnage Float        @default(0) @map("total_tonnage")
  isCompleted  Boolean      @default(false) @map("is_completed")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets         WorkoutSet[]

  @@index([userId])
  @@map("workout_sessions")
}

// Workout Sets table: Hierarchical set information under a session
model WorkoutSet {
  id           String         @id @default(cuid())
  sessionId    String         @map("session_id")
  exerciseName String         @map("exercise_name")
  setNumber    Int            @map("set_number")
  targetWeight Float          @map("target_weight")
  targetReps   Int            @map("target_reps")
  actualWeight Float?         @map("actual_weight")
  actualReps   Int?           @map("actual_reps")
  isCompleted  Boolean        @default(false) @map("is_completed")
  isDropSet    Boolean        @default(false) @map("is_drop_set")
  rpe          Int?           @default(7) @map("rpe")
  orderIndex   Int            @default(0) @map("order_index")
  createdAt    DateTime       @default(now()) @map("created_at")

  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([exerciseName])
  @@map("workout_sets")
}
